# Copy to .env for local development. NEVER commit real secrets.
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0
PUBLIC_CLIENT_URL=http://localhost:5173

DATABASE_URL=postgres://bh:bh_dev_password@localhost:54329/bharat_harvest
TEST_DATABASE_URL=postgres://bh:bh_dev_password@localhost:54329/bharat_harvest_test

# 32+ random bytes, e.g. `openssl rand -hex 32`. Required outside development.
SESSION_SECRET=dev-only-insecure-session-secret-change-me
SESSION_TTL_HOURS=720

# Development auth (username-only login). Refused when APP_ENV=production.
ENABLE_DEV_AUTH=true
# Dev/test-only admin endpoints (time fast-forward). Refused when APP_ENV=production.
ENABLE_DEV_ADMIN=true

# Steam (optional). Server-side ticket validation via the Steam Web API.
STEAM_APP_ID=
STEAM_WEB_API_KEY=

# Simulation
REGION_ID=hemavati
REAL_SECONDS_PER_GAME_DAY=120
WORKER_POLL_MS=2000
MAX_CATCHUP_DAYS_PER_BATCH=30
AI_COMPANY_COUNT=3

# Backups (infra/docker/backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
