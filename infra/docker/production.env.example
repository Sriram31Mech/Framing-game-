# Production configuration for infra/docker/compose.prod.yml.
#
#   cp infra/docker/production.env.example infra/docker/.env.production
#   chmod 600 infra/docker/.env.production
#
# The real file is git-ignored (.env.*). NEVER commit it — this repository is public.
# Values below are placeholders only. Used both for compose interpolation (--env-file) and as the
# environment of the migrate/server/worker containers (env_file).

# --- Edge / TLS -------------------------------------------------------------------------------
# Public hostname; DNS A/AAAA records must point at the VPS before first start (ACME HTTP-01).
DOMAIN=game.example.com
# Contact for the ACME CA (certificate expiry notices).
ACME_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------------------------
# Used for the postgres superuser `bh` and to build DATABASE_URL. Use URL-safe characters only:
#   openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
SERVER_DATABASE_POOL_MAX=20
WORKER_DATABASE_POOL_MAX=5

# --- Image ------------------------------------------------------------------------------------
# Local build tag, or a registry tag such as ghcr.io/<owner>/bharat-harvest:<git-sha>.
APP_IMAGE=bharat-harvest/app:latest

# --- Application (see README "Configuration") --------------------------------------------------
LOG_LEVEL=info
PUBLIC_CLIENT_URL=https://game.example.com
# 32+ random bytes:  openssl rand -hex 32   (rotating it logs every player out — see RUNBOOK)
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_TTL_HOURS=720
ENABLE_PASSWORD_AUTH=true
# Dev auth/admin are forced off by compose and refused by the server in production.

# Steam (optional): enable server-side ticket validation. Keep the Web API key secret.
STEAM_APP_ID=
STEAM_WEB_API_KEY=

# --- Simulation -------------------------------------------------------------------------------
REGION_ID=hemavati
REAL_SECONDS_PER_GAME_DAY=120
WORKER_POLL_MS=2000
MAX_CATCHUP_DAYS_PER_BATCH=30
AI_COMPANY_COUNT=3

# --- Backups (backup service) -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3
# Daily backup time, HH:MM UTC.
BACKUP_AT=02:30
# Weekly restore drill day (1=Mon … 7=Sun); leave empty to disable.
RESTORE_DRILL_WEEKDAY=7
# Optional off-site copy hook. Single quotes keep $1/$2 literal; $1 = dump, $2 = checksum file.
# Put provider credentials in infra/docker/.env.backup (also git-ignored), e.g.
#   BACKUP_UPLOAD_CMD='rclone copy "$1" offsite:bh-backups && rclone copy "$2" offsite:bh-backups'
BACKUP_UPLOAD_CMD=
